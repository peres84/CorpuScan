# ──────────────────────────────────────────────────────────────────────────────
# CorpuScan Frontend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and adjust if needed:
#   cp .env.local.example .env.local
#
# Vite exposes variables prefixed with VITE_ to the client bundle.
# Do NOT put secrets here — this file is compiled into the browser JS.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Backend API URL ─────────────────────────────────────────────────────────
# Points the frontend to the FastAPI backend. All third-party API calls
# (Gemini, Tavily, ElevenLabs, Hera) go through this backend — the frontend
# never contacts external services directly.
#
# Local development:  http://localhost:8000
# Production:         https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:8000
