# ──────────────────────────────────────────────────────────────────────────────
# CorpuScan Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# All keys are server-side only. The frontend never touches these directly.
# ──────────────────────────────────────────────────────────────────────────────

# ─── LLM (Google Gemini) ─────────────────────────────────────────────────────
# Used by all three AI agents (Finance, Scripter, Hera) via google-genai SDK.
GEMINI_API_KEY=key_here
GEMINI_MODEL=model_here
OPENAI_KEY=key_here
OPENAI_MODEL=model_here

# ─── Web Research (Tavily) ───────────────────────────────────────────────────
# Powers URL content extraction and search-query input mode.
# Get a key at https://tavily.com/
TAVILY_API_KEY=key_here

# ─── Text-to-Speech (ElevenLabs) ────────────────────────────────────────────
# Generates the voiceover narration with character-level timestamps.
# Get a key at https://elevenlabs.io/
ELEVENLABS_API_KEY=key_here

# Voice ID for the narrator. Find available voices in your ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=voice_id_here

# ─── Motion Graphics (Hera) ─────────────────────────────────────────────────
# Renders AI-generated animated scenes (intro + 4 content scenes).
# Get a key at https://hera.video/
HERA_API_KEY=key_here

# Base URL for the Hera API. Change only if using a custom/self-hosted instance.
HERA_BASE_URL=https://api.hera.video/v1

# Max seconds to wait for a single Hera render job before timing out.
HERA_RENDER_TIMEOUT_SECONDS=240

# Number of retry attempts per Hera render clip on failure.
HERA_RENDER_RETRY_ATTEMPTS=3

# Seconds between polling requests when checking Hera render status.
HERA_POLL_INTERVAL_SECONDS=3.0

# ─── Cognee Knowledge Memory Layer ──────────────────────────────────────────
# Enables Cognee graph + semantic memory for Audit Investigation Mode.
COGNEE_ENABLED=true

# Local storage location for Cognee data.
# Stores generated knowledge graph / memory artifacts.
COGNEE_STORAGE_PATH=/tmp/cognee

# LLM used internally by Cognee for entity extraction and knowledge creation.
# Should match your OpenAI model strategy.
COGNEE_MODEL=gpt-5-mini

# Embedding model used for semantic retrieval.
COGNEE_EMBEDDING_MODEL=text-embedding-3-small

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default covers Vite dev server (:5173) and the configured dev port (:8080).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
